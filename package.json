{
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@astrojs/solid-js": "7.1.1",
      "@tailwindcss/vite": "4.3.5",
      "@unplugin-pwa/core": "0.0.3",
      "@vite-pwa/astro": "2.0.0",
      "@vite-pwa/workbox-window": "8.0.14",
      "astro": "7.4.2",
      "magicast": "0.5.5",
      "rolldown": "1.2.15",
      "solid-js": "1.9.17",
      "tailwindcss": "4.3.5",
      "wrangler": "4.152.0"
    }
  },
  "scripts": {
    "build": "bun run --sequential --filter='./apps/**' build",
    "deploy": "bun run --filter='./apps/**' deploy",
    "format": "biome check --fix --diagnostic-level error",
    "knip": "bun run --parallel knip:default knip:production knip:strict",
    "knip:default": "knip",
    "knip:production": "knip --production",
    "knip:strict": "knip --strict",
    "lint": "biome check",
    "test": "bun test"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@jridgewell/trace-mapping": "0.3.31",
    "@napi-rs/wasm-runtime": "1.2.6",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "unstorage": "2.0.0-beta.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@gameroman/config": "0.3.0",
    "knip": "6.44.1",
    "typescript": "7.0.2"
  }
}
