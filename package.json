{
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@astrojs/solid-js": "7.0.2",
      "@tailwindcss/vite": "4.3.3",
      "astro": "7.3.1",
      "solid-js": "1.9.15",
      "tailwindcss": "4.3.3",
      "wrangler": "4.129.0"
    }
  },
  "scripts": {
    "build": "bun run --sequential --filter='./apps/**' build",
    "deploy": "bun run --filter='./apps/**' deploy",
    "format": "biome check --fix --diagnostic-level error",
    "knip": "bun run --parallel knip:default knip:production knip:strict",
    "knip:default": "knip",
    "knip:production": "knip --production",
    "knip:strict": "knip --strict",
    "lint": "biome check",
    "test": "bun test"
  },
  "overrides": {
    "@emnapi/runtime": "1.11.3",
    "@jridgewell/trace-mapping": "0.3.31",
    "esbuild": "0.28.2",
    "js-yaml": "npm:neoyaml@0.2.0",
    "semver": "7.8.5",
    "sharp": "0.35.4",
    "unstorage": "2.0.0-alpha.9",
    "yaml": "npm:neoyaml@0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@gameroman/config": "0.2.9",
    "knip": "6.34.0",
    "typescript": "7.0.2"
  }
}
