{
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@astrojs/solid-js": "7.0.1",
      "@tailwindcss/vite": "4.3.3",
      "astro": "7.0.7",
      "solid-js": "1.9.14",
      "tailwindcss": "4.3.3",
      "wrangler": "4.112.0"
    }
  },
  "scripts": {
    "build": "bun run --sequential --filter='./apps/**' build",
    "deploy": "bun run --filter='./apps/**' deploy",
    "format": "biome check --fix --diagnostic-level error",
    "knip": "bun run --parallel knip:default knip:production knip:strict",
    "knip:default": "knip",
    "knip:production": "knip --production",
    "knip:strict": "knip --strict",
    "lint": "biome check",
    "test": "bun test"
  },
  "overrides": {
    "@jridgewell/trace-mapping": "0.3.31",
    "esbuild": "0.28.1",
    "semver": "7.8.5",
    "unstorage": "2.0.0-alpha.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@gameroman/config": "0.2.8",
    "knip": "6.29.0",
    "typescript": "7.0.2"
  }
}
